# ---------------------------------------------------------------------------
# Configuracao do REP-P. Copie para .env e ajuste.
# ---------------------------------------------------------------------------

# Identificacao do empregador (usada no AFD/AEJ e no comprovante)
# 1 = CNPJ, 2 = CPF
EMPREGADOR_TIPO_ID=1
EMPREGADOR_DOCUMENTO=00000000000000
EMPREGADOR_RAZAO_SOCIAL=RAZAO SOCIAL DA EMPRESA LTDA
EMPREGADOR_CNO_CAEPF=
EMPREGADOR_ENDERECO=Rua Exemplo, 100 - Sao Paulo/SP

# Numero de identificacao do REP-P (17 caracteres). Definido no registro do
# programa junto ao INPI / declarado no Atestado Tecnico (ATTR).
REP_IDENTIFICACAO=REPP0000000000001

# Servidor
PORTA=3000
# Interface de escuta. Mantenha 0.0.0.0 apenas se a rede for confiavel;
# para um unico computador use 127.0.0.1.
HOST=0.0.0.0

# Redes das quais marcacoes de ponto sao aceitas (CIDR, separadas por virgula).
# Marcacao remota / por celular fora destas faixas e sempre recusada.
REDES_AUTORIZADAS=127.0.0.1/32,192.168.0.0/16,10.0.0.0/8

# Chave mestra para cifrar templates biometricos em repouso (AES-256-GCM).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAVE_BIOMETRIA=

# Segredo para assinar as sessoes administrativas
SEGREDO_SESSAO=

# A declaracao de comparecimento (consulta/exame do proprio trabalhador) NAO
# obriga o abono pela lei — ela justifica a ausencia, mas as horas podem ser
# descontadas. Marque true apenas se a convencao coletiva da categoria, o
# regulamento interno, ou a pratica ja consolidada da empresa previrem o abono.
ABONA_CONSULTA=false

# Fuso horario oficial dos registros
FUSO=-03:00

# Banco de dados
BANCO=./dados/ponto.db

# Driver biometrico: "simulador" (homologacao/testes) ou "agente" (leitor real)
BIOMETRIA_DRIVER=simulador
BIOMETRIA_AGENTE_URL=http://127.0.0.1:9010
